    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "start:demo": "EXPO_PUBLIC_MIRAIE_DEMO=1 expo start",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:changed": "jest --changedSince=origin/main",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "gates:test": "node --test \"scripts/**/*.test.mjs\""
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
