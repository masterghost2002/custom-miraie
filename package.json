    "@types/react": "~19.3.0",
    "aedes": "^1.2.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^58.0.11",
    "lint-staged": "^17.6.0",
    "mqtt-packet": "^9.0.2",
    "prettier": "^3.9.10",
