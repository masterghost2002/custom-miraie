# Copy to .env.local (never commit it). Every EXPO_PUBLIC_* the app reads must be listed here;
# pnpm check:env-policy fails otherwise.

# 1 = run against the in-memory demo MirAIe (no account needed; used for web previews and screenshots)
EXPO_PUBLIC_MIRAIE_DEMO=0

# Only for `pnpm spike:miraie` on your laptop. The app never reads these; it asks on the Sign in screen.
MIRAIE_LOGIN_ID=
MIRAIE_PASSWORD=
